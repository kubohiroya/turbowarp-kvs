{
  "name": "@kubohiroya/turbowarp-kvs",
  "version": "0.2.0",
  "description": "A portable namespace and key value store extension for TurboWarp.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "homepage": "https://kubohiroya.github.io/turbowarp-kvs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-kvs.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-kvs/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "kvs",
    "storage",
    "vite",
    "typescript"
  ],
  "type": "module",
  "exports": {
    "./binary-object-store": {
      "types": "./dist/modules/binary-object-store.d.ts",
      "import": "./dist/modules/binary-object-store.js"
    },
    "./binary-bundle-store": {
      "types": "./dist/modules/binary-bundle-store.d.ts",
      "import": "./dist/modules/binary-bundle-store.js"
    },
    "./opfs-binary-bundle-store": {
      "types": "./dist/modules/opfs-binary-bundle-store.d.ts",
      "import": "./dist/modules/opfs-binary-bundle-store.js"
    },
    "./session-binary-backing": {
      "types": "./dist/modules/session-binary-backing.d.ts",
      "import": "./dist/modules/session-binary-backing.js"
    },
    "./kvs-store": {
      "types": "./dist/modules/kvs-store.d.ts",
      "import": "./dist/modules/kvs-store.js"
    }
  },
  "files": [
    "dist/",
    "docs/",
    "src/",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc --project tsconfig.build.json",
    "lint": "eslint src tests scripts vite.config.ts eslint.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts",
    "docs:check": "pnpm run docs && git diff --exit-code -- README.md",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "0.3.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "0.3.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "fake-indexeddb": "6.2.5",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
