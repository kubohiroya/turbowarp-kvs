{
  "schemaVersion": 1,
  "productName": "TurboWarp-KVS",
  "packageType": "extension-composition",
  "licensePolicy": "mpl-2.0",
  "readmeLanguages": ["en", "ja"],
  "canonicalReadme": "README.md",
  "localizedReadmes": {
    "ja": "README.ja.md"
  },
  "node": {
    "minimum": "22.18.0"
  },
  "packageManager": "pnpm",
  "requiredFiles": ["README.md", "README.ja.md", "LICENSE"],
  "exceptions": {
    "upstreamFork": false,
    "mixedContentLicenses": false,
    "legacyPackageName": false,
    "thirdPartyBundle": false
  },
  "migrationChecklist": [
    "Keep browser KVS storage isolated from Asset Manager databases.",
    "Keep binary bytes out of Scratch values and manifests.",
    "Run pnpm run check before publishing generated artifacts."
  ]
}
